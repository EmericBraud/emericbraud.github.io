---
layout: base.njk
title: Articles
permalink: /posts/
---
{% set chapters = collections.posts | groupby("data.chapter") %}
{% for chapterName, posts in chapters %}
<h2>{{ chapterName }}</h2>
<ul>
{% for post in posts %}
<li><a href="{{ post.url }}">{{ post.data.title }}</a></li>
{% endfor %}
</ul>
{% endfor %}
