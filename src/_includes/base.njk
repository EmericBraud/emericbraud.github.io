<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="color-scheme" content="light">
<meta name="viewport" content="width=device-width, initial-scale=1">
{% set siteName = "Ce que développer un moteur d'échecs m'a appris" %}
{% set siteDescription = "Les enseignements de programmation tirés du développement de Chess26, un moteur d'échecs écrit en C++23." %}
{% set pageDescription = description or siteDescription %}
<title>{% if title != siteName %}{{ title }} - {% endif %}{{ siteName }}</title>
<meta name="description" content="{{ pageDescription }}">
<meta name="author" content="Emeric Braud">
<meta property="og:type" content="{% if layout == "post.njk" %}article{% else %}website{% endif %}">
<meta property="og:site_name" content="{{ siteName }}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ pageDescription }}">
<meta name="twitter:card" content="summary">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css">
<script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js"></script>
<script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/contrib/auto-render.min.js"
  onload="renderMathInElement(document.body, {
    delimiters: [
      {left: '$$', right: '$$', display: true},
      {left: '$', right: '$', display: false}
    ]
  });"></script>
<script type="module" src="https://cdn.jsdelivr.net/npm/chessboard-element@1.2.0/bundled/chessboard-element.bundled.js"></script>
<script type="module">
  import mermaid from "https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs";
  mermaid.initialize({ startOnLoad: true, theme: "neutral", fontFamily: "Georgia, Times New Roman, serif" });
</script>
<style>
:root { color-scheme: light }

*, *::before, *::after { box-sizing: border-box }
html { background: #f1efe9 }

/* La page, posee sur le fond */
body {
  background: #fff;
  color: #111;
  font-family: "Latin Modern Roman", "Computer Modern", Georgia, "Times New Roman", serif;
  font-size: 1.0625rem;
  line-height: 1.52;
  max-width: 72rem;
  margin: 2.5rem auto;
  padding: 3.5rem clamp(1.25rem, 6vw, 4rem) 4rem;
  border: 1px solid #e0ddd4;
  text-align: justify;
  hyphens: auto;
}

@media (max-width: 77rem) {
  body { margin: 0; border: 0 }
}

/* Titre de page, facon page de garde */
body > h1 {
  font-size: 1.55rem;
  line-height: 1.3;
  text-align: center;
  margin: 0 0 1.25rem;
}

nav, footer, header {
  font-size: 0.9rem;
  text-align: center;
}

nav { margin-bottom: 2.5rem }
header { margin-bottom: 2rem; color: #555 }
header p { text-indent: 0; margin: 0 }

hr {
  border: 0;
  border-top: 1px solid #ddd;
  margin: 2.5rem 0;
}

/* Paragraphes a l indentation LaTeX, sans blanc entre eux */
p { margin: 0; text-indent: 1.4em }
p + p { margin-top: 1.15rem }
h1 + p, h2 + p, h3 + p, blockquote + p, ul + p, ol + p,
figure + p, pre + p, table + p, hr + p { text-indent: 0 }
ul, ol, blockquote, figure, table, pre { margin: 1.1rem 0 }

/* Sections numerotees dans les articles */
article { counter-reset: section }
article h1 {
  counter-reset: subsection;
  font-size: 1.2rem;
  margin: 2rem 0 0.6rem;
}
article h2 { font-size: 1.05rem; margin: 1.5rem 0 0.5rem }
article h1::before { counter-increment: section; content: counter(section) ". " }
article h2::before { counter-increment: subsection; content: counter(section) "." counter(subsection) ". " }

blockquote {
  margin-left: 1.5rem;
  margin-right: 1.5rem;
  font-size: 0.95rem;
}

figure { text-align: center }
figcaption { font-size: 0.9rem; text-align: center; margin-top: 0.4rem }
.mermaid, pre.mermaid { text-align: center; overflow-x: auto }

/* Tableaux facon booktabs : filets horizontaux seulement */
table {
  border-collapse: collapse;
  font-size: 0.95rem;
  margin-left: auto;
  margin-right: auto;
}
table, td, th { border: 0 !important }
thead { border-top: 1px solid #111; border-bottom: 1px solid #111 }
tbody { border-bottom: 1px solid #111 }
th, td { padding: 0.35rem 0.9rem; text-align: left }

code, pre {
  font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
  font-size: 0.88em;
}
pre {
  background: #fafaf7;
  border: 1px solid #ebe8e0;
  padding: 0.7rem 0.9rem;
  overflow-x: auto;
  text-align: left;
  line-height: 1.45;
}
pre.mermaid { background: none; border: 0; padding: 0 }

a { color: #00308f }

/* Navigation de bas d article */
.postnav {
  display: flex;
  justify-content: space-between;
  gap: 2.5rem;
  text-align: left;
  font-size: 1rem;
}
.postnav div { flex: 1 }
.postnav div:last-child { text-align: right }
.postnav span {
  display: block;
  font-size: 0.78rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: #777;
  margin-bottom: 0.15rem;
}
.backlink {
  text-indent: 0;
  text-align: center;
  margin-top: 2.5rem;
  font-size: 0.9rem;
}

@media (max-width: 30rem) {
  .postnav { flex-direction: column; gap: 1.25rem }
  .postnav div:last-child { text-align: left }
}
</style>
</head>
<body>

<h1>{{ title }}</h1>

<nav>
<a href="/">Accueil</a> |
<a href="/about/">A propos</a>
</nav>

<hr>

{{ content | safe }}

<hr>

<footer>
<p>&copy; 2026 Emeric Braud &middot; <a href="https://github.com/EmericBraud/chess26">Chess26 sur GitHub</a></p>
</footer>

</body>
</html>
